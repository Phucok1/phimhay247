# Server Port
PORT=5000
VITE_API_URL=http://localhost:5000/api

# YouTube Data API Key (Tùy chọn, dùng để tự động đọc Playlist nhanh hơn)
YOUTUBE_API_KEY=

# YouTube Channel chính thức
VITE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@phimhay.momtiti

# Firebase Configuration (Điền nếu muốn dùng trực tiếp Firebase thay vì Local Database)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mật khẩu quản trị mặc định (khi chưa cấu hình Firebase Auth)
ADMIN_SECRET_KEY=admin123
